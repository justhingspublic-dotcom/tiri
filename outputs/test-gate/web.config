<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- 全站送出 noindex，Google 完全不收錄（就算之後拿掉密碼也建議留著這段直到轉正式站） -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow, noarchive" />
      </customHeaders>
    </httpProtocol>

    <!-- 密碼閘門：沒有正確 cookie 的人一律 302 到維護頁 -->
    <!-- 改密碼：把下面 pattern 裡的 tiri2026 換掉即可（限英數字，避免特殊符號） -->
    <rewrite>
      <rules>
        <rule name="PasswordGate" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_COOKIE}" pattern="tiri_auth=tiri2026" negate="true" />
            <add input="{URL}" pattern="^/maintenance\.html$" negate="true" />
            <add input="{URL}" pattern="^/robots\.txt$" negate="true" />
            <add input="{URL}" pattern="^/favicon\.ico$" negate="true" />
          </conditions>
          <action type="Redirect" url="/maintenance.html" redirectType="Temporary" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
