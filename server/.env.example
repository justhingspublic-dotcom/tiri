# 複製成 .env 後填入實際值（每台機器各自保管一份，不進 git、不進部署包）

# 公司 SQL Server —— 資料一律存這裡
# 本機開發 DB_NAME=TIRI_dev、正式站 DB_NAME=TIRI（就靠這行分開發/正式）
DB_SERVER=192.168.1.92
DB_USER=sa
DB_PASS=（資料庫密碼）
DB_NAME=TIRI_dev

# session 加密金鑰（正式站要換成一長串隨機字串）
SECRET_KEY=（隨機字串）

# 後台登入帳密（僅第一次啟動、users 表是空的時候拿來播種；之後以後台「帳號設定」為準）
ADMIN_EMAIL=office@tiri.tw
ADMIN_PASS=tiri1234

# 允許的前端網域（逗號分隔；* = 全部允許，測試用，正式站建議收斂）
ALLOWED_ORIGINS=*

# 以下皆為備援值：正式值存在資料庫 mail_settings 表，後台「郵件設定」可改
MAIL_TO=office@tiri.tw
MAIL_DRY_RUN=1
