# 複製成 .env 後填入實際值

# 寄信設定（用 Gmail 的話：smtp.gmail.com / 587 / 應用程式密碼）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your@gmail.com

# 通知信收件人（逗號分隔可多個）
MAIL_TO=office@tiri.tw

# 設 1 = 不真的寄信，只印在終端機（測試用）
MAIL_DRY_RUN=1

# 後台登入帳密
ADMIN_EMAIL=office@tiri.tw
ADMIN_PASS=tiri1234

# session 加密金鑰（上線換成隨機字串）
SECRET_KEY=tiri-transitional-backend

# 允許的前端網域（逗號分隔；* = 全部允許，測試用）
ALLOWED_ORIGINS=*
